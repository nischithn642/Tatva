# TATVA Environment Variable Configuration Example
# Copy this file to '.env' and fill in your private API keys.
# NEVER commit your '.env' file to source control.

# Anthropic Claude API Key (Used for automated failure diagnostics)
TATVA_ANTHROPIC_KEY=sk-ant-example_key_here

# Resend API Key & Email Configuration (Used for contact form notifications)
RESEND_API_KEY=re_example_key_here
RESEND_FROM_EMAIL=TATVA Team <contact@tatvacompiler.com>
NOTIFICATION_EMAIL=team@tatvacompiler.com

# Supabase Credentials (Used for backend contact database operations)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example_key_here
