# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg
*.egg-info/
.installed.cfg

# --- Environments ---
.venv/
_clean_env/
env/
venv/
ENV/
node_modules/

# --- Packaging / build output ---
# `build_*/` rather than an ever-growing list of specific names: `tatva optimize --out`
# takes an arbitrary directory, and every one of those directories is regenerable.
build/
build_*/
dist/
develop-eggs/
downloads/
eggs/
.eggs/
parts/
sdist/
var/
wheels/
share/python-wheels/

# --- Compiler artifacts (generated into build dirs by tatva) ---
*.o
*.elf
*.bin
weights.h
model_run.c
model_info.h
operators.c

# --- Scratch: keep the helper scripts, drop the generated build dirs ---
# scratch/val_build_* used to be committed: 497 copied TVM headers, 75% of every
# clone, for build output that any `tatva optimize` run regenerates. The *_build_*
# glob covers whatever the next helper script decides to name its output directory.
scratch/*_build_*/
scratch/*.elf
scratch/*.bin

# --- Local LLM settings: save() writes the user's API key into this file ---
config/scaffolding_config.json

# --- Secrets (.env.example IS tracked; it is the template) ---
.env
!.env.example

# --- Local backups & logs ---
_backup/
logs/*.log

# --- Bundled toolchains: too large for git, fetched by `tatva setup` ---
# `tatva setup` now installs to a per-user directory outside the repo. These two are
# the legacy in-repo locations that the old setup_env.py used; still ignored so an
# existing checkout does not suddenly offer half a gigabyte of binaries for commit.
qemu/
riscv-toolchain/
renode/

# --- Large model fixtures: small ones are tracked, these are not ---
models/model_pretrained.onnx
models/model_pretrained_quant.onnx
models/model_medium.onnx
models/model_medium_quant.onnx

# --- Editor / OS ---
.DS_Store
Thumbs.db
.idea/
*.swp
